---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects, formatDateRange } from '../../lib/projects';

const projects = await getProjects();
---

<BaseLayout title="Projects">
  <h1>Projects</h1>
  <ul class="project-grid">
    {projects.map((project) => {
      const { title, summary, startDate, endDate, cover, coverAlt, coverPosition } = project.data;
      return (
        <li>
          <a class="project-card" href={`/projects/${project.id}`}>
            {cover ? (
              <Image
                src={cover}
                alt={coverAlt ?? ''}
                width={960}
                class="card-cover"
                style={`object-position: ${coverPosition}`}
              />
            ) : (
              <div class="card-cover placeholder" aria-hidden="true" />
            )}
            <div class="card-body">
              <h2>{title}</h2>
              <p class="dates">{formatDateRange(startDate, endDate)}</p>
              <p class="summary">{summary}</p>
            </div>
          </a>
        </li>
      );
    })}
  </ul>
</BaseLayout>

<style>
  h1 {
    margin: 1rem 0 0;
  }

  .project-grid {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    /* Two cards per row on desktop, one on tablets and phones */
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
    gap: 1.5rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid #ddd;
    border-radius: 8px;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .project-card:hover,
  .project-card:focus-visible {
    border-color: #1a1a1a;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  }

  /* Cover photo, cropped to a consistent 3:2 shape (set `cover` in the project's frontmatter) */
  .card-cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  /* Stand-in until a project has a cover photo; matches the Home banner */
  .card-cover.placeholder {
    background: linear-gradient(135deg, #1a1a1a, #3a3f47);
  }

  .card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.1rem 1.25rem 1.4rem;
  }

  h2 {
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.3;
  }

  .dates {
    margin: 0;
    color: #666;
    font-size: 0.9rem;
  }

  .summary {
    margin: 0;
    color: #333;
  }
</style>
