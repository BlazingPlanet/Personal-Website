---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects, formatDateRange, type Project } from '../../lib/projects';

// Build one page per project, at /projects/<markdown file name>.
export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
// The cover photo is only used on the Projects list cards; put photos in the Markdown body here
const { title, startDate, endDate } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={title}>
  <a class="back-link" href="/projects">← All projects</a>

  <header class="project-header">
    <h1>{title}</h1>
    <p class="dates">{formatDateRange(startDate, endDate)}</p>
  </header>

  <article class="prose">
    <Content />
  </article>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    margin: 1rem 0 0.75rem;
    color: #555;
    text-decoration: none;
    font-size: 0.95rem;
  }

  .back-link:hover {
    color: #1a1a1a;
  }

  .project-header {
    border-bottom: 1px solid #ddd;
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
  }

  .project-header h1 {
    margin: 0 0 0.25rem;
    font-size: clamp(1.6rem, 4vw, 2.25rem);
    line-height: 1.2;
  }

  .dates {
    margin: 0;
    color: #666;
  }

  /* Styles for the rendered Markdown. :global() is needed because Astro's scoped
     styles don't otherwise reach elements that come from the Markdown file. */
  /* Keep lines of text at a comfortable reading width; photos use the full width */
  .prose > :global(*) {
    max-width: 72ch;
  }

  .prose > :global(p:has(> img)) {
    max-width: none;
  }

  .prose :global(h2) {
    margin: 2rem 0 0.5rem;
    font-size: 1.35rem;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h3) {
    margin: 1.5rem 0 0.4rem;
    font-size: 1.1rem;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
  }

  /* Two or more images on consecutive lines in the Markdown display side by side
     (stacked on phones) */
  .prose :global(p:has(> img + img)) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 0.75rem;
    margin: 1.5rem 0;
  }

  .prose :global(p:has(> img + img) img) {
    width: 100%;
  }

  /* Photo/video beside text: wrap two <div>s in <div class="media-row"> in the Markdown.
     The first column is wider; add "narrow-first" for a narrow first column (good for tall
     photos and portrait videos). They stack on narrow screens. */
  .prose :global(.media-row) {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 1.75rem;
    align-items: center;
    max-width: none;
    margin: 1.25rem 0 1.75rem;
  }

  .prose :global(.media-row.narrow-first) {
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
  }

  .prose :global(.media-row > div > :first-child) {
    margin-top: 0;
  }

  .prose :global(.media-row > div > :last-child) {
    margin-bottom: 0;
  }

  /* Text beside a photo/video is a bit larger so it balances the media */
  .prose :global(.media-row p:not(.caption)) {
    font-size: 1.15rem;
    line-height: 1.65;
  }

  /* Captions under a single photo in a row are centered beneath it */
  .prose :global(.media-row .caption) {
    text-align: center;
  }

  .prose :global(.media-row img),
  .prose :global(.media-row video) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
  }

  @media (max-width: 700px) {
    .prose :global(.media-row),
    .prose :global(.media-row.narrow-first) {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  /* Small italic note under a photo: <p class="caption"><em>...</em></p> in the Markdown */
  .prose :global(.caption) {
    margin-top: -0.75rem;
    font-size: 0.9rem;
    color: #666;
  }

  /* YouTube embeds: paste the iframe into the Markdown and it scales to the column width. */
  .prose :global(iframe) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 6px;
  }

  .prose :global(pre) {
    overflow-x: auto;
    padding: 1rem;
    background: #f6f6f6;
    border-radius: 6px;
  }
</style>
