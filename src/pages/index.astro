---
import BaseLayout from '../layouts/BaseLayout.astro';
import Highlights from '../components/Highlights.astro';

import { Image } from 'astro:assets';
import headshot from '../assets/headshot.jpg';
---

<BaseLayout>
  <section class="hero" slot="banner">
    <h1>Home</h1>
  </section>
  <section id="about">
    <div class="section-heading">
      <h2>About Me</h2>
      <a class="resume-button" href="/resume.pdf" download="Trevor-Taylor-Resume.pdf">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 2v8m0 0L4.5 6.5M8 10l3.5-3.5M2.5 13.5h11" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Resume
      </a>
    </div>
    <div class="about-content">
      <Image src={headshot} alt="Trevor Taylor" width={520} class="headshot" />
      <div class="about-text">
        <p>
          Hello! I'm Trevor Taylor, an aerospace engineer at Collins Aerospace in San Diego, where I
          perform structural analysis on commercial aircraft nacelles. I'm also pursuing my M.S. in
          Aerospace Engineering at Georgia Tech.
        </p>
        <p>
          My passion is, and always has been, rocketry. I've built many model rockets, designed and
          tested solid rocket motors from scratch, and most recently built a thrust-vector-controlled
          rocket with its own integrated launch system. This was my most ambitious project yet, and
          you can find the full build on the <a href="/projects">Projects</a> page!
        </p>
        <p>
          For me, this all connects to something bigger: a deep love for the United States and a
          belief that strong deterrence is what keeps freedom secure. I am interested in mission
          critical defense systems, particularly missiles, space assets, and threat interceptors.
        </p>
        <p>
          If you'd like to talk engineering, rockets, or opportunities, reach me at <a href="mailto:trevor@twtaylor.com">trevor@twtaylor.com</a>.
        </p>
      </div>
    </div>
  </section>

  <section id="highlights">
    <div class="section-heading">
      <h2>Highlights</h2>
    </div>
    <Highlights />
  </section>
</BaseLayout>

<style>
  section {
    margin-bottom: 3rem;
  }

  .hero {
    display: grid;
    place-items: center;
    min-height: clamp(166px, 23vw, 256px);
    margin-bottom: 1.5rem;
    /* Top padding leaves room for the name and nav, which sit over the banner, and sets "Home"
       a little below center so it has breathing room from the nav */
    padding: 5rem 1.5rem 3rem;
    background: linear-gradient(135deg, #1a1a1a, #3a3f47);
    color: #fff;
    text-align: center;
  }

  /* On the narrowest phones the nav wraps below the name, so the header is taller;
     "Home" sits just below the nav instead of centered, to keep the banner short */
  @media (max-width: 360px) {
    .hero {
      padding: 7.5rem 1.5rem 2rem;
    }
  }

  .hero h1 {
    font-size: clamp(2rem, 6vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: 0.02em;
    margin: 0;
  }

  .about-content {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
  }

  .headshot {
    width: 260px;
    height: auto;
    flex-shrink: 0;
  }

  .about-text p:first-child {
    margin-top: 0;
  }

  @media (max-width: 640px) {
    .about-content {
      flex-direction: column;
    }

    .headshot {
      width: 100%;
      max-width: 320px;
    }
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid #ddd;
    padding-bottom: 0.4rem;
    margin-bottom: 1rem;
  }

  .section-heading h2 {
    margin: 0;
  }

  /* Small outlined pill: easy to find next to the heading without competing with the content */
  .resume-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.85rem;
    border: 1px solid #ccc;
    border-radius: 999px;
    color: #1a1a1a;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.15s, background 0.15s;
  }

  .resume-button:hover,
  .resume-button:focus-visible {
    border-color: #1a1a1a;
    background: #f6f6f6;
  }

  .resume-button svg {
    width: 1em;
    height: 1em;
  }
</style>
