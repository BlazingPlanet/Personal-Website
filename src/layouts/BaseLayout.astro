---
import '../styles/global.css';
import { getProjects } from '../lib/projects';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} | Trevor W. Taylor` : 'Trevor W. Taylor';

const projects = await getProjects();

const navLinks = [
  { href: '/', label: 'Home' },
  {
    href: '/projects',
    label: 'Projects',
    children: projects.map((p) => ({ href: `/projects/${p.id}`, label: p.data.title })),
  },
  { href: '/contact', label: 'Contact' },
];

// Pages that fill the banner slot get the header laid over the banner (see .has-banner in global.css)
const hasBanner = Astro.slots.has('banner');

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body class:list={[{ 'has-banner': hasBanner }]}>
    <header class="site-header">
      <a href="/" class="site-name">Trevor W. Taylor</a>
      <nav>
        {navLinks.map((link) =>
          link.children ? (
            <div class="nav-item">
              <a href={link.href} class:list={[{ active: isActive(link.href) }]}>
                {link.label}
              </a>
              <ul class="nav-dropdown">
                {link.children.map((child) => (
                  <li>
                    <a href={child.href}>{child.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <a href={link.href} class:list={[{ active: isActive(link.href) }]}>
              {link.label}
            </a>
          )
        )}
      </nav>
    </header>

    <slot name="banner" />

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Trevor W. Taylor</p>
    </footer>
  </body>
</html>